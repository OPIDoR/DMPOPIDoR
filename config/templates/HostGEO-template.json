{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "../Documentation/Implementation/data_model/Json/",
    "title": "HostGEO",
    "description": "HostGEO template",
    "dataTypes": [
        "dataset"
    ],
    "topics": null,
    "type": "object",
    "class": "HostGEO",
    "properties": {
        "title": {
            "type": "string",
            "description": "Host title",
            "label@fr_FR": "Titre",
            "label@en_GB": "Title",
            "tooltip": null,
            "form_label@fr_FR": "Titre",
            "form_label@en_GB": "Title"
        },
        "hostId": {
            "type": "string",
            "description": "Persistent identifier or URL",
            "label@fr_FR": "Identifiant de l'entrepôt",
            "label@en_GB": "Repository ID",
            "tooltip": null,
            "form_label@fr_FR": "Identifiant de l'entrepôt",
            "form_label@en_GB": "Repository ID"
        },
        "idType": {
            "type": "string",
            "description": "Identification system",
            "inputType": "dropdown",
            "label@fr_FR": "Type d'identifiant",
            "label@en_GB": "Identifier type",
            "registryCategory": "PIDSystem",
            "overridable": true,
            "tooltip": null,
            "form_label@fr_FR": "Type d'identifiant",
            "form_label@en_GB": "Identifier type"
        },
        "policyUrl": {
            "type": "string",
            "description": "Host data policy",
            "label@fr_FR": "Politique de données",
            "label@en_GB": "Data policy",
            "tooltip": null
        },
        "geoLocation": {
            "type": "string",
            "description": "Host country code",
            "inputType": "dropdown",
            "label@fr_FR": "Localisation géographique (pays)",
            "label@en_GB": "Geo location (country)",
            "registryCategory": "ISO3166-alpha2",
            "tooltip": null,
            "form_label@fr_FR": "Localisation géographique (pays)",
            "form_label@en_GB": "Geo location (country)"
        },
        "certification": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Certifications held by the host (CoreTrustSEal, DSA, WDS, ISO-9001, …)",
            "inputType": "dropdown",
            "label@fr_FR": "Certification",
            "label@en_GB": "Certification",
            "registryCategory": "Certification",
            "overridable": true,
            "tooltip": null,
            "form_label@fr_FR": "Certification/Label qualité",
            "form_label@en_GB": "Certification/Quality label"
        },
        "pidSystem": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "System of persistent identifiers implemented by the host",
            "inputType": "dropdown",
            "label@fr_FR": "Système d'identifiants",
            "label@en_GB": "PID system",
            "registryCategory": "PIDSystem",
            "overridable": true,
            "tooltip": null,
            "form_label@fr_FR": "Système d'identifiants",
            "form_label@en_GB": "PID system"
        },
        "hasVersioningPolicy": {
            "type": "string",
            "description": "Versioning policy",
            "label@fr_FR": "Politique de gestion des versions",
            "label@en_GB": "Versioning policy",
            "tooltip": null,
            "hidden": true,
            "form_label@fr_FR": "Politique de gestion des versions",
            "form_label@en_GB": "Versioning policy"
        },
        "availability": {
            "type": "number",
            "description": "Host availability/sustainability in years (until what year?)",
            "label@fr_FR": "Disponibilité (années)",
            "label@en_GB": "Availability (years)",
            "tooltip": null,
            "hidden": true,
            "form_label@fr_FR": "Disponibilité (années)",
            "form_label@en_GB": "Availability (years)"
        },
        "metadataStandard": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Export formats compliant with metadata standards provided by the host.",
            "inputType": "dropdown",
            "label@fr_FR": "Standards de métadonnées disponibles",
            "label@en_GB": "Available metadata standards",
            "registryCategory": "StandardsShort",
            "overridable": true,
            "tooltip": null,
            "form_label@fr_FR": "Standards de métadonnées disponibles",
            "form_label@en_GB": "Available metadata standards"
        },
        "apiStandard": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "API Standards implemented by the host",
            "inputType": "dropdown",
            "label@fr_FR": "Standard d'interoperabilité OGC",
            "label@en_GB": "OGC Interoperability Standard",
            "registryCategory": "OGCStandard",
            "overridable": true,
            "tooltip": null,
            "form_label@fr_FR": "Choississez le standard d'interoperabilité OGC lié à vos données",
            "form_label@en_GB": "Select associate OGC Interoperability Standard of Data"
        }
    },
    "required": [
        "title",
        "hostId",
        "idType",
        "geoLocation"
    ],
    "to_string": [
        "$.title",
        " : ",
        "$.hostId",
        " (",
        "$.certification",
        ")"
    ]
}