            "form_label@fr_FR": "Acronyme",
            "form_label@en_GB": "Acronym"
        },
        "orgId": {
            "type": "string",
            "description": "Identifier of the entity",
            "label@fr_FR": "Identifiant",
            "label@en_GB": "Identifier",
