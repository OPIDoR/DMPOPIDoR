<% title "#{@plan.title} - contributors" %>

<% content_for :plan_tab_body do %>
  <%= react("ContributorsTabLayout", props: { 
    locale: LocaleService.to_gettext(locale: locale),
    planId: @plan.id,
    planTitle: @plan.title,
    dmpId: @plan.json_fragment.id,
    readonly: !@plan.editable_by?(current_user.id),
    clientsName: @plan.api_clients.pluck("name")
  }) %>
<% end %>

<%= render partial: "plans/navigation", locals: { plan: @plan } %>
