<% title "#{plan.title} - Write plan" %>

<% locale = LocaleService.to_gettext(locale: locale)%>

<% content_for :plan_tab_body do %>
  <% if plan.structured? %>
    <%= react("WritePlanLayout", props: { 
      locale: locale,
      planId: plan.id,
      planTitle: plan.title,
      dmpId: plan.json_fragment.id,
      userId: @current_user.id,
      readonly: !plan.editable_by?(current_user.id),
      commentablePlan: plan.commentable_by?(current_user.id),
      configuration: Rails.configuration.x.dmpopidor.front,
      clientsName: plan.api_clients.pluck("name")
    }) %>
  <% else %>
    <% write_plan_class = active_page?(edit_plan_path(plan.id)) && !plan.structured? ? "write-plan" : ""%>
    <div class="tab-content">
      <div class="row">
        <div class="col-md-12">
          <!-- render the project title -->
          <h1 id="plan-title">
            <%= plan.title %>
          </h1>
        </div>
      </div>
      <div id="content" role="tabpanel" class="tab-pane active row col-md-12">
        <div class="plan-content card card-default">
          <div class="card-body <%= write_plan_class %> ">
            <%= render partial: 'phases/edit_plan_answers',
                      locals: {
                        plan: plan,
                        phase: phase,
                        answers: answers,
                        readonly: readonly,
                        base_template_org: base_template_org,
                        guidance_presenter: guidance_presenter,
                      } %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<%= render partial: "plans/navigation", locals: { plan: plan } %>
