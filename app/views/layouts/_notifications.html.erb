<% notifications.each do |a| %>
  <% unless a.acknowledged?(current_user) %>
    <div id="<%= dom_id(a) %>" class="notification alert alert-<%= a.level %>">
      <span class="fas <%= fa_classes(a) %>"></span>
      <span class="notification-body"><%= sanitize a.body %></span>
      <% if a.dismissable? %>
          <%= button_to user_acknowledge_notification_path(current_user, notification_id: a.id),
            method: :post,
            class: "close",
            aria: { label: "Close" } do %>
          <span class="fas fa-circle-xmark" aria-hidden="true"></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
