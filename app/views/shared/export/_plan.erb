<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <title><%= @plan.title %></title>
    <%= render partial: 'shared/export/plan_styling',
               locals: {
                 font_face: @formatting[:font_face],
                 font_size: "#{@formatting[:font_size]}pt",
                 margin: "#{@formatting[:margin][:top]}px #{@formatting[:margin][:right]}px #{@formatting[:margin][:bottom]}px #{@formatting[:margin][:left]}px"
               } %>
  </head>
  <body>
    <% if @options[:show_coversheet] %>
      <%= render partial: 'shared/export/plan_coversheet' %>
    <% end %>

    <% partial_name = @plan.structured? ? 'plan_structured_export' : 'plan_classic_export'%>
    <%= render partial: "shared/export/#{partial_name}",
               locals: {
                 plan: @plan,
                 phases: @hash[:phases],
                 research_outputs: @hash[:research_outputs]
               }
    %>
  </body>
</html>
