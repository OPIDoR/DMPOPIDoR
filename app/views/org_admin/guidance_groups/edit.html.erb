<% title _('Guidance group') %>
<div class="row">
  <div class="col-md-12">
    <h1><%= _('Guidance group') %></h1>
    <%= link_to _('View all guidance'), org_admin_guidances_path,
                                        class: 'btn btn-secondary float-end' %>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <%= form_for(@guidance_group, url: org_admin_guidance_group_path(@guidance_group),
                                  html: { method: :put, id: "admin_update_guidance_group_form" }) do |f| %>
      <%= render partial: "form",
                 locals: {
                   form: f,
                 } %>
    <% end %>
  </div>
</div>
