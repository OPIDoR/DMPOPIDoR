<div class="dmpopidor-front-page">
  <div class="row main-title">
    <h1>
      <%= _('News') %>
    </h1>
    <h2 class="see-all-news">
      <a href="https://opidor.fr/toutes-les-actualites/"><%= _('View all')%></a>
    </h2>
    <%= link_to(
          current_user ? new_plan_path(anchor: 'content') :
            login_path(place: 'signin', redirect_to: new_plan_path(anchor: 'content')),
          class: "dmp-visit",
          style: "cursor: pointer; text-decoration: none;"
        ) do %>
      <h2><%= _('Create plan') %></h2>
      <i class="fa-solid fa-pencil" aria-hidden="true"></i>
    <% end %>
  </div>
  <div class="row">
    <%= react("NewsPageLayout", props: { locale: locale }) %>
  </div>
</div>
