<p>
  <%= sanitize _("<br>The selected user's content will be merged into the account for %{user_email}. <br> The selected account will then be removed") % {user_email: @user.email} %>
</p>

<%# Le controller est déclaré ici, sur le conteneur injecté par Turbo Stream %>
<div data-controller="merge-user">

  <%# Valeur cachée pour l'email de l'utilisateur en cours d'édition %>
  <input type="hidden"
         data-merge-user-target="editingUserEmail"
         value="<%= @user.email %>">

  <%= form_tag(merge_super_admin_user_path(@user), method: 'put', class: 'form-inline') do %>
    <div class="form-control mb-3">
      <div class="input-group">
        <span class="input-group-text" id="search-addon">
          <span class="fas fa-magnifying-glass" aria-hidden="true"></span>
        </span>
        <%= select_tag(:merge_id,
              options_from_collection_for_select(@users, "id", "email"),
              class: "form-select",
              data: {
                merge_user_target: "userSelect",
                action: "change->merge-user#updateConfirmation"
              }) %>
      </div>
    </div>

    <%= submit_tag _("Merge"),
          class: 'btn btn-secondary',
          style: 'margin-top: 8px;',
          data: { merge_user_target: "submitButton" } %>
    <%= link_to _("Cancel"), edit_super_admin_user_path(@user), class: 'btn btn-secondary' %>
  <% end %>

</div>
