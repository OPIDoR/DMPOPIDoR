<%= turbo_stream.replace "api-client-form" do %>
  <%= render "form" %>
<% end %>

<%= turbo_stream.after "api-client-form" do %>
  <script>
    toggleSpinner(false)
    renderNotice("<%= j(@success ? _("Successfully regenerated the client credentials.") : _("Unable to regenerate the client credentials.")) %>")
  </script>
<% end %>
